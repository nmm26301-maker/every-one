      "sha256": "2e02b2e415ae9b274fb7cea69757903405a9f7b3d56c83b8cf1bdeaf8ab924c7",
      "bytes": 11721
    },
    {
      "key": "u25_1",
      "text": "Luckily, a friend offered me a ride.",
