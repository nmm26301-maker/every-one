      "sha256": "35b13fa0e45291087f5f2187018a8c1514298ec3a3f4a33c4df7246cfbf7690b",
      "bytes": 7802
    },
    {
      "key": "u21_2",
      "text": "Does this bus go to the airport?",
      "pack": "level2.zip",
      "sha256": "3d3e0288b8a1850cf7eb7ac2a55674e6105ff6a6b8f58883533733f148991dbb",
      "bytes": 10676
    },
    {
      "key": "u22_0",
      "text": "I'd like to book an appointment.",
      "pack": "level2.zip",
      "sha256": "f19dbb6413777ee58968e0434b8dd49b9d73fbb1c4c8d55c16ba2ec0b63fa04a",
      "bytes": 9762
    },
    {
      "key": "u22_1",
      "text": "Could we move it to Monday?",
      "pack": "level2.zip",
      "sha256": "a022232b1dccc488a02a0822e35648736f7ce46ec634f439d8d3d96e56ae47d0",
      "bytes": 8586
    },
    {
      "key": "u22_2",
      "text": "Is there anything available in the afternoon?",
