      "sha256": "3f82323ffebd54a4073f9f3b4d20e61d3758549e48d3863428d8860b5fa626af",
      "bytes": 9631
    },
    {
      "key": "u20_2",
      "text": "Could we have the bill, please?",
      "pack": "level2.zip",
      "sha256": "8d604e1e5a04776afee4dc2f08a6554b3879a404da4e504140ca88e949f91059",
      "bytes": 10023
    },
    {
      "key": "u21_0",
      "text": "I think I missed my stop.",
