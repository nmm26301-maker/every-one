    },
    {
      "key": "u18_1",
      "text": "What are your plans for the weekend?",
      "pack": "level2.zip",
      "sha256": "3ddbf9d821948cc4263800d05cb983ffcd292a57193484ae40ed5396dd38f175",
      "bytes": 10415
    },
