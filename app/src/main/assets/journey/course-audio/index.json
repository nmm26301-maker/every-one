      "sha256": "125d344bf208b6cee4b4df2f8c44e472ae3387e84082ce82e6e2bfe04d3f2a4d",
      "bytes": 7933
    },
    {
      "key": "u24_1",
      "text": "Could I exchange it for another one?",
