      "sha256": "e888740889fa844a49fcc1afd01c72b6fe1f0d7d0f8ac5b77d19ea27359b7744",
      "bytes": 10545
    },
    {
      "key": "u19_1",
      "text": "What time is breakfast?",
      "pack": "level2.zip",
      "sha256": "066b0ad296534ed3e50be55bd57717689893756698ea174c9c8aa547c3a081b9",
      "bytes": 7541
    },
    {
      "key": "u19_2",
      "text": "Could I have a quiet room?",
