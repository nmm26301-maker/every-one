      "sha256": "5f96feeee256bd542e9daa761bbe82bbe5a6c1adb2b7e80a32c6410c36b5defd",
      "bytes": 13419
    },
    {
      "key": "u25_2",
      "text": "It turned out to be a memorable day.",
